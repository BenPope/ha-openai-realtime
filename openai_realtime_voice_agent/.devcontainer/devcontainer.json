{
  "name": "OpenAI Realtime Voice Agent",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "appPort": [
    "8081:8081"
  ],
  "forwardPorts": [
    8081
  ],
  "postCreateCommand": "poetry install",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}